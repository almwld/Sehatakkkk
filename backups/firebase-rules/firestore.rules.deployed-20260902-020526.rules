rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in
           get(/databases/$(database)/documents/chats/$(chatId))
             .data.participants;
    }

    // ============================================================
    // Users
    // ============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ============================================================
    // Wallet
    // ============================================================

    match /users/{userId}/meta/wallet {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ============================================================
    // Transactions
    // ============================================================

    match /users/{userId}/transactions/{transactionId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ============================================================
    // Orders
    // ============================================================

    match /orders/{orderId} {
      allow read: if signedIn()
                  && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // Medicines
    // ============================================================

    match /medicines/{medicineId} {
      allow read: if true;

      allow write: if signedIn()
                   && request.auth.token.admin == true;
    }

    // ============================================================
    // Doctors
    // ============================================================

    match /doctors/{doctorId} {
      allow read: if true;

      allow write: if signedIn()
                   && request.auth.token.admin == true;
    }

    // ============================================================
    // Articles
    // ============================================================

    match /articles/{articleId} {
      allow read: if true;

      allow write: if signedIn()
                   && request.auth.token.admin == true;
    }

    // ============================================================
    // Posts
    // ============================================================

    match /posts/{postId} {
      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // Chats
    // ============================================================

    match /chats/{chatId} {

      // المستخدم يستطيع قراءة محادثاته فقط.
      allow read: if signedIn()
                  && request.auth.uid in resource.data.participants;

      // إنشاء محادثة:
      // يجب أن يكون المستخدم الحالي أحد المشاركين.
      allow create: if signedIn()
                    && request.resource.data.participants is list
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() >= 2
                    && request.resource.data.participants.size() <= 50;

      // التحديث المباشر من العميل مسموح فقط للمشارك،
      // مع منع تغيير قائمة المشاركين.
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants
                       == resource.data.participants;

      // الحذف للمشارك فقط.
      allow delete: if signedIn()
                    && request.auth.uid in resource.data.participants;

      // ==========================================================
      // Messages
      // ==========================================================

      match /messages/{messageId} {

        // قراءة الرسائل للمشاركين فقط.
        allow read: if isChatParticipant(chatId);

        // إنشاء الرسالة:
        // senderId يجب أن يكون المستخدم الموثق.
        allow create: if isChatParticipant(chatId)
                      && signedIn()
                      && request.resource.data.senderId == request.auth.uid;

        // تحديث الرسالة:
        // المرسل فقط يستطيع تعديل رسالته.
        allow update: if isChatParticipant(chatId)
                      && signedIn()
                      && resource.data.senderId == request.auth.uid;

        // حذف الرسالة للمرسل فقط.
        allow delete: if isChatParticipant(chatId)
                      && signedIn()
                      && resource.data.senderId == request.auth.uid;
      }
    }

    // ============================================================
    // Default deny
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
