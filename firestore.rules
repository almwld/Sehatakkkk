rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // 🔐 دوال مساعدة
    // ============================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          .hasAny([request.auth.uid]);
    }

    function isCallParticipant(callId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/calls/$(callId)).data.participants
          .hasAny([request.auth.uid]);
    }

    // ============================================================
    // 👤 المستخدمين
    // ============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      allow create: if isAuthenticated();
    }

    // ============================================================
    // 👨‍⚕️ الأطباء (قراءة عامة)
    // ============================================================
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.isDoctor == true;
    }

    // ============================================================
    // 💬 المحادثات - ZERO-TRUST
    // ============================================================
    match /chats/{chatId} {
      allow read: if isChatParticipant(chatId);
      
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      
      allow update: if isChatParticipant(chatId) &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'lastMessage',
            'lastMessageTime',
            'lastMessageSenderId',
            'updatedAt',
            'unreadCount',
            'isArchived',
            'isPinned',
            'isMuted'
          ]);
      
      allow delete: if isChatParticipant(chatId);
    }

    // ============================================================
    // ✉️ الرسائل - ZERO-TRUST
    // ============================================================
    match /chats/{chatId}/messages/{messageId} {
      allow read: if isChatParticipant(chatId);

      allow create: if isChatParticipant(chatId) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.chatId == chatId;

      allow update: if isChatParticipant(chatId) &&
        (
          (resource.data.senderId == request.auth.uid &&
            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly(['text', 'isEdited', 'isDeleted', 'reactions'])) ||
          (request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly(['isRead', 'readAt', 'isDelivered', 'deliveredAt']))
        );

      allow delete: if isChatParticipant(chatId) &&
        (resource.data.senderId == request.auth.uid ||
         request.auth.token.isAdmin == true);
    }

    // ============================================================
    // 📞 المكالمات - ZERO-TRUST
    // ============================================================
    match /calls/{callId} {
      allow read: if isCallParticipant(callId);
      
      allow create: if isAuthenticated() &&
        request.resource.data.callerId == request.auth.uid &&
        request.auth.uid in request.resource.data.participants;
      
      allow update: if isCallParticipant(callId) &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'isAnswered',
            'connectedAt',
            'endedAt',
            'durationSeconds'
          ]);
      
      allow delete: if isAuthenticated() &&
        (resource.data.callerId == request.auth.uid ||
         request.auth.token.isAdmin == true);
    }

    // ============================================================
    // 🔔 الإشعارات
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }
  }
}
