rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // Helpers
    // ═══════════════════════════════════════════════════════════
    function isSignedIn() { return request.auth != null; }
    function isSelf(userId) { return isSignedIn() && request.auth.uid == userId; }
    function userExists(userId) { return exists(/databases/$(database)/documents/users/$(userId)); }
    function userData(userId) { return get(/databases/$(database)/documents/users/$(userId)).data; }
    function userDataAfter(userId) { return getAfter(/databases/$(database)/documents/users/$(userId)).data; }
    function isAdmin() { return isSignedIn() && userExists(request.auth.uid) && (userData(request.auth.uid).role == 'admin' || userData(request.auth.uid).role == 'superAdmin'); }
    function isSuperAdmin() { return isSignedIn() && userExists(request.auth.uid) && userData(request.auth.uid).role == 'superAdmin'; }
    function isDoctorUser(userId) { return userExists(userId) && userData(userId).role == 'doctor'; }
    function isVerifiedDoctor(userId) { return isDoctorUser(userId) && userData(userId).isVerified == true; }

    // ═══════════════════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════════════════
    match /health_metrics/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId) 
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.role != 'doctor' 
            || request.resource.data.doctorId == request.auth.uid);
      allow update: if isAdmin()
        || (isSelf(userId)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'role',
              'isVerified',
              'verificationStatus',
              'isAdmin',
              'isSuperAdmin',
              'permissions',
              'adminPermissions'
            ]))
        // FCM token lifecycle may update only these fields even when an
        // older user document does not contain a role field.
        || (isSelf(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['fcmToken', 'fcmTokens', 'lastTokenUpdate']));
      allow delete: if isAdmin();

      match /vital_history/{historyId} { allow read, write: if isSelf(userId); }

      match /favorites/{doctorId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId) && request.resource.data.doctorId == doctorId;
        allow delete: if isSelf(userId);
        allow update: if false;
      }

      // Public social graph used by the canonical profile screen.
      // Each user can only mutate their own following edge; the target
      // follower edge is writable only by the follower who owns that edge.
      match /following/{targetUserId} {
        allow read: if isSignedIn();
        allow create, delete: if isSelf(userId)
          && targetUserId != userId;
        allow update: if false;
      }

      match /children/{childId} { allow read, write: if isSelf(userId); match /records/{recordId} { allow read, write: if isSelf(userId); } match /growth/{entryId} { allow read, write: if isSelf(userId); } }
      match /mood_entries/{entryId} { allow read, write: if isSelf(userId); }
      match /symptom_checks/{checkId} { allow read, write: if isSelf(userId); }
      match /vaccinations/{vaccinationId} { allow read, write: if isSelf(userId); }

      match /followers/{followerUserId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn()
          && followerUserId == request.auth.uid
          && followerUserId != userId;
        allow update: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // DOCTORS
    // ═══════════════════════════════════════════════════════════
    match /doctors/{doctorId} {
      allow read: if true;
      allow create: if isSelf(doctorId) 
        && userDataAfter(doctorId).role == 'doctor';
      allow update: if isAdmin()
        || (isSelf(doctorId)
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'isVerified',
              'verificationStatus',
              'verifiedBy',
              'verifiedAt'
            ]));
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // CHATS
    // ═══════════════════════════════════════════════════════════
    match /chats/{chatId} {