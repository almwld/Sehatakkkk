rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function chatExists(chatId) {
      return exists(
        /databases/$(database)/documents/chats/$(chatId)
      );
    }

    function chatData(chatId) {
      return get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data;
    }

    function isChatParticipant(chatId) {
      return isSignedIn()
        && chatExists(chatId)
        && request.auth.uid in chatData(chatId).participants;
    }

    function isExistingChatParticipant(chatId) {
      return isSignedIn()
        && resource.data.participants != null
        && request.auth.uid in resource.data.participants;
    }

    function isCreatingChatParticipant() {
      return isSignedIn()
        && request.resource.data.participants != null
        && request.auth.uid in request.resource.data.participants;
    }

    function isMessageSender() {
      return isSignedIn()
        && request.resource.data.senderId == request.auth.uid;
    }

    // ============================================================
    // Users
    // ============================================================

    match /users/{userId} {

      allow read:
        if isSelf(userId);

      allow create:
        if isSelf(userId);

      allow update:
        if isSelf(userId);

      allow delete:
        if isSelf(userId);
    }

    // ============================================================
    // Chats
    // ============================================================

    match /chats/{chatId} {

      // المستخدم يستطيع قراءة المحادثة
      // إذا كان أحد المشاركين فيها.
      allow read:
        if isChatParticipant(chatId);

      // إنشاء محادثة:
      // المستخدم يجب أن يكون أحد المشاركين.
      allow create:
        if isCreatingChatParticipant();

      // تحديث المحادثة:
      // يجب أن يكون المستخدم مشاركًا مسبقًا
      // وألا يستطيع تغيير المشاركين إلى قائمة
      // لا تحتوي عليه.
      allow update:
        if isExistingChatParticipant(chatId)
        && request.resource.data.participants != null
        && request.auth.uid in request.resource.data.participants;

      // منع حذف مستند المحادثة مباشرة.
      allow delete:
        if false;

      // ==========================================================
      // Messages
      // ==========================================================

      match /messages/{messageId} {

        // القراءة فقط للمشاركين في المحادثة.
        allow read:
          if isChatParticipant(chatId);

        // إنشاء رسالة:
        // يجب أن يكون المرسل هو المستخدم الحالي
        // وأن يكون مشاركًا في المحادثة.
        allow create:
          if isChatParticipant(chatId)
          && isMessageSender()
          && request.resource.data.chatId == chatId;

        // تحديث الرسالة:
        // المرسل يستطيع تعديل رسالته،
        // أو يمكن للمشارك تحديث حالة القراءة.
        allow update:
          if isChatParticipant(chatId)
          && (
            resource.data.senderId == request.auth.uid
            ||
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'isRead',
                  'readAt'
                ])
            )
          );

        // لا يوجد حذف فعلي للرسائل من العميل.
        // الحذف المنطقي يستخدم isDeleted.
        allow delete:
          if false;
      }
    }

    // ============================================================
    // Default deny
    // ============================================================

    match /{document=**} {
      allow read, write:
        if false;
    }
  }
}
