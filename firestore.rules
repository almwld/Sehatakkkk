rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // 🔐 دوال مساعدة
    // ============================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          .hasAny([request.auth.uid]);
    }

    function isCallParticipant(callId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/calls/$(callId)).data.participants
          .hasAny([request.auth.uid]);
    }

    // ============================================================
    // 👤 المستخدمين
    // ============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      allow create: if isAuthenticated();
    }

    // ============================================================
    // 👨‍⚕️ الأطباء (قراءة عامة)
    // ============================================================
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.isDoctor == true;
    }

    // ============================================================
    // 💬 المحادثات
    // ============================================================
    match /chats/{chatId} {
      allow read: if isChatParticipant(chatId);
      allow write: if isChatParticipant(chatId);
      allow create: if isAuthenticated();
      allow delete: if isChatParticipant(chatId);

      // منع تعديل participants مباشرة (للأمان)
      allow update: if isChatParticipant(chatId) &&
        !('participants' in request.resource.data) &&
        !('participantDetails' in request.resource.data);
    }

    // ============================================================
    // ✉️ الرسائل
    // ============================================================
    match /chats/{chatId}/messages/{messageId} {
      // قراءة: فقط المشاركون في المحادثة
      allow read: if isChatParticipant(chatId);

      // إنشاء: فقط المشاركون في المحادثة، والمرسل هو المستخدم المصادق
      allow create: if isChatParticipant(chatId) &&
        request.resource.data.senderId == request.auth.uid;

      // تحديث:
      // 1. المرسل يمكنه تعديل محتوى رسالته (isEdited, text)
      // 2. أي مشارك يمكنه تحديث isRead (لـ markAsRead)
      // 3. المرسل يمكنه حذف رسالته (isDeleted)
      allow update: if isChatParticipant(chatId) &&
        (
          // ✅ المرسل: يمكنه تعديل رسالته
          (resource.data.senderId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys
              .hasAny(['text', 'isEdited', 'isDeleted', 'reactions', 'attachments'])) ||
          // ✅ أي مشارك: يمكنه تحديث حالة القراءة
          (request.resource.data.diff(resource.data).affectedKeys
            .hasAny(['isRead', 'readAt', 'isDelivered', 'deliveredAt']))
        );

      // حذف نهائي: فقط المرسل، أو المشرف
      allow delete: if isChatParticipant(chatId) &&
        (resource.data.senderId == request.auth.uid ||
         request.auth.token.isAdmin == true);
    }

    // ============================================================
    // 📞 المكالمات
    // ============================================================
    match /calls/{callId} {
      allow read: if isCallParticipant(callId);
      allow write: if isCallParticipant(callId);
      allow create: if isAuthenticated();
      allow update: if isCallParticipant(callId);
      allow delete: if isAuthenticated() &&
        (resource.data.callerId == request.auth.uid ||
         request.auth.token.isAdmin == true);
    }

    // ============================================================
    // 🔔 الإشعارات
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // 📅 المواعيد
    // ============================================================
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() &&
        (resource.data.patientId == request.auth.uid ||
         resource.data.doctorId == request.auth.uid);
      allow write: if isAuthenticated() &&
        (resource.data.patientId == request.auth.uid ||
         resource.data.doctorId == request.auth.uid);
    }

    // ============================================================
    // 📰 المقالات (قراءة عامة)
    // ============================================================
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.isAdmin == true;
    }

    // ============================================================
    // 💊 الأدوية (قراءة عامة)
    // ============================================================
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.isAdmin == true;
    }

    // ============================================================
    // 🏥 المستشفيات (قراءة عامة)
    // ============================================================
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.isAdmin == true;
    }

    // ============================================================
    // 🧪 المختبرات (قراءة عامة)
    // ============================================================
    match /labs/{labId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.isAdmin == true;
    }

    // ============================================================
    // 💊 الصيدليات (قراءة عامة)
    // ============================================================
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.isAdmin == true;
    }

    // ============================================================
    // 📦 الطلبات
    // ============================================================
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // 💰 المحفظة
    // ============================================================
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
