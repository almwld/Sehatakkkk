rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(userId) { return isSignedIn() && request.auth.uid == userId; }
    function userExists(userId) { return exists(/databases/$(database)/documents/users/$(userId)); }
    function userData(userId) { return get(/databases/$(database)/documents/users/$(userId)).data; }
    function userDataAfter(userId) { return getAfter(/databases/$(database)/documents/users/$(userId)).data; }
    function isAdmin() { return isSignedIn() && userExists(request.auth.uid) && userData(request.auth.uid).role == 'admin'; }
    function isDoctorUser(userId) { return userExists(userId) && userData(userId).role == 'doctor'; }
    function isVerifiedDoctor(userId) { return isDoctorUser(userId) && userData(userId).isVerified == true; }
    function consultationExists(id) { return exists(/databases/$(database)/documents/consultations/$(id)); }
    function consultationData(id) { return get(/databases/$(database)/documents/consultations/$(id)).data; }
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && request.resource.data.uid == request.auth.uid && (request.resource.data.role != 'doctor' || request.resource.data.doctorId == request.auth.uid);
      allow update: if isAdmin() || (isSelf(userId) && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role && request.resource.data.doctorId == resource.data.doctorId && request.resource.data.isVerified == resource.data.isVerified && request.resource.data.verificationStatus == resource.data.verificationStatus);
      allow delete: if isAdmin();
    }
    match /users/{userId}/favorites/{doctorId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && request.resource.data.doctorId == doctorId && request.resource.data.doctorId != '';
      allow delete: if isSelf(userId);
      allow update: if false;
    }
    match /users/{userId}/medications/{medicationId} {
      allow read: if isSelf(userId) || isAdmin() || (isSignedIn() && isVerifiedDoctor(request.auth.uid) && resource.data.doctorId == request.auth.uid);
      allow create: if isAdmin() || (isSelf(userId) && request.resource.data.userId == request.auth.uid) || (isSignedIn() && isVerifiedDoctor(request.auth.uid) && request.resource.data.userId == userId && request.resource.data.doctorId == request.auth.uid && consultationExists(request.resource.data.consultationId) && consultationData(request.resource.data.consultationId).doctorId == request.auth.uid && consultationData(request.resource.data.consultationId).patientId == userId);
      allow update: if isAdmin() || (isSelf(userId) && request.resource.data.userId == resource.data.userId && request.resource.data.doctorId == resource.data.doctorId) || (isSignedIn() && isVerifiedDoctor(request.auth.uid) && resource.data.doctorId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.doctorId == resource.data.doctorId);
      allow delete: if isAdmin() || isSelf(userId);
    }
    match /users/{userId}/medications_history/{historyId} {
      allow read, create: if isSelf(userId) && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isSelf(userId);
    }
    match /doctors/{doctorId} {
      allow read: if isAdmin() || isSelf(doctorId) || resource.data.isVerified == true;
      allow create: if isSelf(doctorId) && userDataAfter(doctorId).role == 'doctor' && userDataAfter(doctorId).doctorId == doctorId && request.resource.data.userId == doctorId && request.resource.data.isVerified == false && request.resource.data.isAvailable == false && request.resource.data.isOnline == false;
      allow update: if isAdmin() || (isSelf(doctorId) && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.isVerified == resource.data.isVerified && (request.resource.data.isAvailable == false || isVerifiedDoctor(request.auth.uid)));
      allow delete: if isAdmin();
    }
    match /hospitals/{hospitalId} { allow read: if true; allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid); allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid); }
    match /labs/{labId} { allow read: if true; allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.isVerified == false); allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.isVerified == resource.data.isVerified && request.resource.data.verificationStatus == resource.data.verificationStatus); allow delete: if isAdmin(); }

    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'pending');
      allow update: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }
    match /pharmacy_products/{submissionId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.pharmacyId == request.auth.uid));
      allow create, update, delete: if false;
    }
    match /drug_catalog/{drugId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /product_inventory/{productId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /products/{productId} {
      allow read: if resource.data.approvalStatus == 'approved' && resource.data.isPublished == true && resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /lab_bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.patientId == request.auth.uid) || (isSignedIn() && exists(/databases/$(database)/documents/labs/$(resource.data.labId)) && get(/databases/$(database)/documents/labs/$(resource.data.labId)).data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin() || (isSignedIn() && resource.data.patientId == request.auth.uid && request.resource.data.patientId == resource.data.patientId && request.resource.data.labId == resource.data.labId && request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','notes','updatedAt','cancelledAt']));
      allow delete: if isAdmin();
    }
    match /lab_results/{resultId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.patientId == request.auth.uid) || (isSignedIn() && exists(/databases/$(database)/documents/labs/$(resource.data.labId)) && get(/databases/$(database)/documents/labs/$(resource.data.labId)).data.userId == request.auth.uid);
      allow create, update: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/labs/$(request.resource.data.labId)) && get(/databases/$(database)/documents/labs/$(request.resource.data.labId)).data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /articles/{articleId} { allow read: if resource.data.isPublished == true || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /community_posts/{postId} { allow read: if resource.data.isPublished == true || isAdmin(); allow create: if isSignedIn(); allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid); allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid); }
    function chatExists(chatId) { return exists(/databases/$(database)/documents/chats/$(chatId)); }
    function chatData(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
    function isChatParticipant(chatId) { return isSignedIn() && chatExists(chatId) && request.auth.uid in chatData(chatId).participants; }
    match /chats/{chatId} { allow read: if isChatParticipant(chatId); allow create: if isSignedIn() && request.resource.data.participants != null && request.auth.uid in request.resource.data.participants; allow update: if isChatParticipant(chatId) && request.auth.uid in request.resource.data.participants; allow delete: if false;
      match /messages/{messageId} { allow read: if isChatParticipant(chatId); allow create: if isChatParticipant(chatId) && request.resource.data.senderId == request.auth.uid && request.resource.data.chatId == chatId; allow update: if isChatParticipant(chatId) && (resource.data.senderId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead','readAt'])); allow delete: if false; }
    }
    match /calls/{callId} { allow read: if isSignedIn() && request.auth.uid in resource.data.participants; allow create: if isSignedIn() && request.resource.data.callerId == request.auth.uid && request.resource.data.receiverId is string && request.resource.data.receiverId != request.auth.uid && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants && request.resource.data.receiverId in request.resource.data.participants; allow update: if isSignedIn() && request.auth.uid in resource.data.participants && request.resource.data.callerId == resource.data.callerId && request.resource.data.receiverId == resource.data.receiverId && request.resource.data.participants == resource.data.participants && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','isAnswered','connectedAt','endedAt','durationSeconds']); allow delete: if false; }
    function appointmentExists(id) { return exists(/databases/$(database)/documents/appointments/$(id)); }
    function appointmentData(id) { return get(/databases/$(database)/documents/appointments/$(id)).data; }
    function isAppointmentPatient(id) { return isSignedIn() && appointmentExists(id) && appointmentData(id).patientId == request.auth.uid; }
    function isAppointmentDoctor(id) { return isSignedIn() && appointmentExists(id) && appointmentData(id).doctorId == request.auth.uid; }
    match /appointments/{appointmentId} { allow create: if false; allow read: if isAdmin() || isAppointmentPatient(appointmentId) || isAppointmentDoctor(appointmentId); allow update: if isAdmin() || (isAppointmentPatient(appointmentId) && request.resource.data.patientId == resource.data.patientId && request.resource.data.doctorId == resource.data.doctorId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date','time','status','updatedAt','cancelledAt']) && request.resource.data.status in ['cancelled','pending']) || (isAppointmentDoctor(appointmentId) && isVerifiedDoctor(request.auth.uid) && request.resource.data.patientId == resource.data.patientId && request.resource.data.doctorId == resource.data.doctorId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','confirmedAt','updatedAt']) && request.resource.data.status in ['confirmed','completed']); allow delete: if false; }
    match /wallets/{userId} { allow read: if isSelf(userId) || isAdmin(); allow write: if false; }
    match /transactions/{transactionId} { allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid); allow create, update, delete: if false; }
    match /consultations/{consultationId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid));
      allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && ((resource.data.patientId == request.auth.uid) || (isVerifiedDoctor(request.auth.uid) && resource.data.doctorId == request.auth.uid)));
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}