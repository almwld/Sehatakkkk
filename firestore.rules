rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // Helpers
    // ═══════════════════════════════════════════════════════════
    function isSignedIn() { return request.auth != null; }
    function isSelf(userId) { return isSignedIn() && request.auth.uid == userId; }
    function userExists(userId) { return exists(/databases/$(database)/documents/users/$(userId)); }
    function userData(userId) { return get(/databases/$(database)/documents/users/$(userId)).data; }
    function userDataAfter(userId) { return getAfter(/databases/$(database)/documents/users/$(userId)).data; }
    function isAdmin() { return isSignedIn() && userExists(request.auth.uid) && (userData(request.auth.uid).role == 'admin' || userData(request.auth.uid).role == 'superAdmin'); }
    function isSuperAdmin() { return isSignedIn() && userExists(request.auth.uid) && userData(request.auth.uid).role == 'superAdmin'; }
    function isDoctorUser(userId) { return userExists(userId) && userData(userId).role == 'doctor'; }
    function isVerifiedDoctor(userId) { return isDoctorUser(userId) && userData(userId).isVerified == true; }

    // ═══════════════════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════════════════
    match /health_metrics/{userId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId) 
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.role != 'doctor' 
            || request.resource.data.doctorId == request.auth.uid);
      allow update: if isAdmin() 
        || (isSelf(userId) 
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();

      match /vital_history/{historyId} { allow read, write: if isSelf(userId); }

      match /favorites/{doctorId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId) && request.resource.data.doctorId == doctorId;
        allow delete: if isSelf(userId);
        allow update: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // DOCTORS
    // ═══════════════════════════════════════════════════════════
    match /doctors/{doctorId} {
      allow read: if true;
      allow create: if isSelf(doctorId) 
        && userDataAfter(doctorId).role == 'doctor';
      allow update: if isAdmin() 
        || (isSelf(doctorId) 
            && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // CHATS
    // ═══════════════════════════════════════════════════════════
    match /chats/{chatId} {
      // ✅ get: وثيقة محددة
      allow get: if isSignedIn() 
        && (!exists(/databases/$(database)/documents/chats/$(chatId))
            || (resource.data.participants is list
                && request.auth.uid in resource.data.participants));
      
      // ✅ list: query (مهم لـwhere().get())
      allow list: if isSignedIn();
      
      // ✅ create
      allow create: if isSignedIn() 
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 1
        && request.resource.data.participants.size() <= 100;
      
      // ✅ update
      allow update: if isSignedIn() 
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      
      // ✅ delete
      allow delete: if isSignedIn() 
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() 
          && (!exists(/databases/$(database)/documents/chats/$(chatId))
              || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        
        allow create: if isSignedIn() 
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.chatId == chatId;
        
        allow update: if isSignedIn() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        allow delete: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // CALLS — مرنة
    // ═══════════════════════════════════════════════════════════
    match /calls/{callId} {
      // ✅ allow get — يقبل جديد (transaction) أو participant
      allow get: if isSignedIn() 
        && (!exists(/databases/$(database)/documents/calls/$(callId))
            || (resource.data.participants is list
                && request.auth.uid in resource.data.participants));
      
      // ✅ allow list — للـqueries
      allow list: if isSignedIn();
      
      // ✅ allow create
      allow create: if isSignedIn() 
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
      
      // ✅ allow update — participant
      allow update: if isSignedIn() 
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      
      // ✅ allow delete — participant
      allow delete: if isSignedIn() 
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }

    // ═══════════════════════════════════════════════════════════
    // CALLLOCKS — مرنة
    // ═══════════════════════════════════════════════════════════
    match /callLocks/{lockId} {
      allow get: if isSignedIn() 
        && (!exists(/databases/$(database)/documents/callLocks/$(lockId))
            || (resource.data.participants is list
                && request.auth.uid in resource.data.participants));
      
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() 
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants;
      
      allow update: if isSignedIn() 
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      
      allow delete: if isSignedIn() 
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }

    // ═══════════════════════════════════════════════════════════
    // PROFESSIONAL VERIFICATION
    // ═══════════════════════════════════════════════════════════
    match /verification_requests/{requestId} {
      allow get: if isSignedIn() && (request.auth.uid == requestId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /admin_daily_reports/{reportId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // NOTIFICATIONS
    // ═══════════════════════════════════════════════════════════
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /notifications_log/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // STATUSES (24h stories)
    // ═══════════════════════════════════════════════════════════
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /views/{viewerId} {
        allow read: if isSignedIn() && viewerId == request.auth.uid;
        allow create, update: if isSignedIn() && viewerId == request.auth.uid;
        allow delete: if isSignedIn() && viewerId == request.auth.uid;
      }

      match /reactions/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && userId == request.auth.uid;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // APPOINTMENTS
    // ═══════════════════════════════════════════════════════════
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() 
        && (!exists(/databases/$(database)/documents/appointments/$(appointmentId))
            || resource.data.patientId == request.auth.uid
            || resource.data.doctorId == request.auth.uid);
      
      allow list: if isSignedIn();
      
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.doctorId != null;
      
      allow update: if isSignedIn() 
        && (resource.data.patientId == request.auth.uid
            || resource.data.doctorId == request.auth.uid);
      
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // HEALTHCARE (public read)
    // ═══════════════════════════════════════════════════════════
    match /labs/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pharmacies/{id} { allow read: if true; allow write: if isAdmin(); }
    match /hospitals/{id} { allow read: if true; allow write: if isAdmin(); }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /lab_categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /articles/{id} { allow read: if true; allow write: if isAdmin(); }
    match /tips/{id} { allow read: if true; allow write: if isAdmin(); }
    match /cities/{id} { allow read: if true; allow write: if isAdmin(); }
    match /regions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /specialties/{id} { allow read: if true; allow write: if isAdmin(); }
    match /health_contacts/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // ═══════════════════════════════════════════════════════════
    // COMMUNITY
    // ═══════════════════════════════════════════════════════════
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() 
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════
    // MISC
    // ═══════════════════════════════════════════════════════════
    match /blood_donors/{donorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /wallets/{walletId} {
      allow read: if isSignedIn() && isSelf(walletId);
      allow write: if false;
    }

    match /transactions/{txnId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // DEFAULT DENY
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
