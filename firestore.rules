rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(userId) { return isSignedIn() && request.auth.uid == userId; }
    function userExists(userId) { return exists(/databases/$(database)/documents/users/$(userId)); }
    function userData(userId) { return get(/databases/$(database)/documents/users/$(userId)).data; }
    function userDataAfter(userId) { return getAfter(/databases/$(database)/documents/users/$(userId)).data; }
    function isAdmin() { return isSignedIn() && userExists(request.auth.uid) && userData(request.auth.uid).role == 'admin'; }
    function isDoctorUser(userId) { return userExists(userId) && userData(userId).role == 'doctor'; }
    function isVerifiedDoctor(userId) { return isDoctorUser(userId) && userData(userId).isVerified == true; }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && request.resource.data.uid == request.auth.uid && (request.resource.data.role != 'doctor' || request.resource.data.doctorId == request.auth.uid);
      allow update: if isAdmin() || (isSelf(userId) && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role && request.resource.data.doctorId == resource.data.doctorId && request.resource.data.isVerified == resource.data.isVerified && request.resource.data.verificationStatus == resource.data.verificationStatus);
      allow delete: if isAdmin();
    }

    match /users/{userId}/favorites/{doctorId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && request.resource.data.doctorId == doctorId && request.resource.data.doctorId != '';
      allow delete: if isSelf(userId);
      allow update: if false;
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow create: if isSelf(doctorId) && userDataAfter(doctorId).role == 'doctor' && userDataAfter(doctorId).doctorId == doctorId && request.resource.data.userId == doctorId && request.resource.data.isVerified == false && request.resource.data.isAvailable == false && request.resource.data.isOnline == false;
      allow update: if isAdmin() || (isSelf(doctorId) && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId && request.resource.data.isVerified == resource.data.isVerified && (request.resource.data.isAvailable == false || isVerifiedDoctor(request.auth.uid)));
      allow delete: if isAdmin();
    }

    function chatExists(chatId) { return exists(/databases/$(database)/documents/chats/$(chatId)); }
    function chatData(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
    function isChatParticipant(chatId) { return isSignedIn() && chatExists(chatId) && request.auth.uid in chatData(chatId).participants; }
    function isExistingChatParticipant(chatId) { return isSignedIn() && resource.data.participants != null && request.auth.uid in resource.data.participants; }
    function isCreatingChatParticipant() { return isSignedIn() && request.resource.data.participants != null && request.auth.uid in request.resource.data.participants; }
    function isMessageSender() { return isSignedIn() && request.resource.data.senderId == request.auth.uid; }

    match /chats/{chatId} {
      allow read: if isChatParticipant(chatId);
      allow create: if isCreatingChatParticipant();
      allow update: if isExistingChatParticipant(chatId) && request.resource.data.participants != null && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId) && isMessageSender() && request.resource.data.chatId == chatId;
        allow update: if isChatParticipant(chatId) && (
          resource.data.senderId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead','readAt'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) && request.resource.data.reactions is map && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']) && request.resource.data.deletedFor is map && request.resource.data.deletedFor.diff(resource.data.deletedFor).affectedKeys().hasOnly([request.auth.uid]) && request.resource.data.deletedFor[request.auth.uid] == true)
        );
        allow delete: if false;
      }
    }

    function appointmentExists(appointmentId) { return exists(/databases/$(database)/documents/appointments/$(appointmentId)); }
    function appointmentData(appointmentId) { return get(/databases/$(database)/documents/appointments/$(appointmentId)).data; }
    function isAppointmentPatient(appointmentId) { return isSignedIn() && appointmentExists(appointmentId) && appointmentData(appointmentId).patientId == request.auth.uid; }
    function isAppointmentDoctor(appointmentId) { return isSignedIn() && appointmentExists(appointmentId) && appointmentData(appointmentId).doctorId == request.auth.uid; }
    function isCreatingAppointment() { return isSignedIn() && request.resource.data.patientId == request.auth.uid && request.resource.data.doctorId != null && request.resource.data.doctorId != '' && request.resource.data.status == 'pending' && request.resource.data.type in ['in_person','video','phone'] && request.resource.data.date is timestamp && request.resource.data.time is string && request.resource.data.doctorName is string && request.resource.data.doctorSpecialty is string && exists(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId)); }
    match /appointments/{appointmentId} {
      allow read: if isAdmin() || isAppointmentPatient(appointmentId) || isAppointmentDoctor(appointmentId);
      allow create: if isCreatingAppointment();
      allow update: if isAdmin() || (isAppointmentPatient(appointmentId) && request.resource.data.patientId == resource.data.patientId && request.resource.data.doctorId == resource.data.doctorId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date','time','status','updatedAt','cancelledAt']) && (request.resource.data.status == 'cancelled' || request.resource.data.status == 'pending')) || (isAppointmentDoctor(appointmentId) && isVerifiedDoctor(request.auth.uid) && request.resource.data.patientId == resource.data.patientId && request.resource.data.doctorId == resource.data.doctorId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','confirmedAt','updatedAt']) && (request.resource.data.status == 'confirmed' || request.resource.data.status == 'completed'));
      allow delete: if false;
    }

    match /labs/{labId} { allow read: if true; allow write: if isAdmin(); }
    match /products/{productId} { allow read: if true; allow write: if isAdmin(); }

    function isCallParticipant(callId) { return isSignedIn() && exists(/databases/$(database)/documents/calls/$(callId)) && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants; }
    match /calls/{callId} {
      allow read: if isCallParticipant(callId);
      allow create: if isSignedIn() && request.resource.data.callerId == request.auth.uid && request.auth.uid in request.resource.data.participants;
      allow update: if isCallParticipant(callId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','isAnswered','connectedAt','endedAt','durationSeconds']);
      allow delete: if isSignedIn() && (resource.data.callerId == request.auth.uid || request.auth.token.isAdmin == true);
    }

    // Deterministic per-pair lock prevents two devices from creating calls
    // for the same pair at the same time. Both participants may manage only
    // locks that include their own UID.
    match /callLocks/{lockId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && request.auth.uid in request.resource.data.participants;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
