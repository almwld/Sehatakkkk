// ✅ في chat_screen.dart، استبدل PopupMenuButton بالقائمة التالية:

// ✅ زر القائمة - إعدادات الدردشة
PopupMenuButton<String>(
  icon: Icon(Icons.more_vert, color: isDark ? Colors.white : Colors.black87),
  onSelected: (value) {
    switch (value) {
      case 'settings':
        Navigator.push(
          context,
          MaterialPageRoute(
            builder: (_) => ChatSettingsScreen(
              chatId: 'global',
              chatName: 'جميع المحادثات',
            ),
          ),
        );
        break;
      case 'background':
        ToastService.showInfo('🖼️ تغيير خلفية الدردشة');
        break;
      case 'notifications':
        ToastService.showInfo('🔔 إدارة الإشعارات');
        break;
      case 'mode':
        ToastService.showInfo('🌙 تغيير الوضع');
        break;
      case 'export':
        ToastService.showInfo('📤 تصدير المحادثات');
        break;
      case 'clear':
        _clearAllChats();
        break;
    }
  },
  itemBuilder: (context) => [
    const PopupMenuItem(
      value: 'settings',
      child: Row(
        children: [
          Icon(Icons.settings, color: AppColors.primary),
          SizedBox(width: 8),
          Text('إعدادات الدردشة'),
        ],
      ),
    ),
    const PopupMenuItem(
      value: 'background',
      child: Row(
        children: [
          Icon(Icons.wallpaper, color: AppColors.primary),
          SizedBox(width: 8),
          Text('خلفية الدردشة'),
        ],
      ),
    ),
    const PopupMenuItem(
      value: 'notifications',
      child: Row(
        children: [
          Icon(Icons.notifications, color: AppColors.primary),
          SizedBox(width: 8),
          Text('الإشعارات'),
        ],
      ),
    ),
    const PopupMenuItem(
      value: 'mode',
      child: Row(
        children: [
          Icon(Icons.dark_mode, color: AppColors.primary),
          SizedBox(width: 8),
          Text('الوضع المظلم'),
        ],
      ),
    ),
    const PopupMenuItem(
      value: 'export',
      child: Row(
        children: [
          Icon(Icons.ios_share, color: AppColors.primary),
          SizedBox(width: 8),
          Text('تصدير المحادثات'),
        ],
      ),
    ),
    const PopupMenuItem(
      value: 'clear',
      child: Row(
        children: [
          Icon(Icons.delete_sweep, color: Colors.red),
          SizedBox(width: 8),
          Text('حذف الكل', style: TextStyle(color: Colors.red)),
        ],
      ),
    ),
  ],
),
