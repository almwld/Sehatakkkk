<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ✅ Launch Theme -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#00796B</item>
        <item name="android:navigationBarColor">#00796B</item>
    </style>

    <!-- ✅ Normal Theme -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- ✅ Notification Style -->
    <style name="NotificationStyle" parent="Theme.AppCompat.Light">
        <item name="android:statusBarColor">#00796B</item>
        <item name="android:navigationBarColor">#00796B</item>
    </style>
</resources>
