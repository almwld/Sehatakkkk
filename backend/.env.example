# ============================================================
# SEHATAK BACKEND
# ============================================================
PORT=3000

# ============================================================
# NEXTCLOUD
# ============================================================
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=sehatak_service
NEXTCLOUD_PASSWORD=CHANGE_THIS_PASSWORD
NEXTCLOUD_ROOT_PATH=Sehatak

# ============================================================
# FIREBASE ADMIN — existing project only
# ============================================================
FIREBASE_PROJECT_ID=sehatak-platform
FIREBASE_STORAGE_BUCKET=sehatak-platform.firebasestorage.app

# Choose ONE credential method:
# A) Preferred on managed hosts: set GOOGLE_APPLICATION_CREDENTIALS to the
#    mounted service-account JSON file path, or use the host's ADC identity.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
# B) Or supply both fields (never commit real values):
# FIREBASE_CLIENT_EMAIL=service-account@sehatak-platform.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# ============================================================
# LIVEKIT
# ============================================================
LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
